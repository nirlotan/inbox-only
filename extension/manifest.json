{
  "manifest_version": 3,
  "name": "Inbox Only",
  "description": "Instagram as a plain messenger: your DMs stay, feeds, reels, stories and videos are blocked.",
  "version": "1.0.0",
  "icons": {
    "48": "icon-48.png",
    "96": "icon-96.png",
    "128": "icon-128.png",
    "256": "icon-256.png",
    "512": "icon-512.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*", "https://instagram.com/*"],
      "js": ["inbox-only.user.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
